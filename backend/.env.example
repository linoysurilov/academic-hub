# Copy to .env for local development. On Render/Railway, set these in the dashboard.

APP_NAME=Personal AI Hub
APP_ENV=development
PORT=8000

# Comma-separated browser origins allowed to call this API.
# Production example: https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional regex for Vercel preview deployments.
FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# Preferred: full SQLAlchemy URL. Render/Railway often provide postgres:// — that is normalized automatically.
DATABASE_URL=postgresql+psycopg2://hub:hub@localhost:5432/personal_ai

# Used if DATABASE_URL is not set.
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=personal_ai

# Internal URL the task agent uses to create tasks. In production, use this service's public URL.
TASKS_API_URL=http://127.0.0.1:8000/tasks
