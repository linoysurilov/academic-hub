# Local: copy to `.env` (Vite loads this automatically).
# Vercel: set the same keys in Project Settings → Environment Variables.

# FastAPI origin after deploying to Render or Railway (no trailing slash).
# Local dev can leave this empty and use the Vite `/api` proxy.
VITE_API_BASE=http://127.0.0.1:8000

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
