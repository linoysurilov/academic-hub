# Shared cloud-config map. Copy values into:
# - frontend/.env  (or Vercel env)
# - backend/.env   (or Render / Railway env)

# --- Frontend (Vercel) ---
VITE_API_BASE=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend (Render / Railway) ---
APP_ENV=development
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app
DATABASE_URL=postgresql+psycopg2://hub:hub@localhost:5432/personal_ai
TASKS_API_URL=http://127.0.0.1:8000/tasks
